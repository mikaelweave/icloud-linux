#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_NAME="icloud.service"
SERVICE_SCOPE="user"
SYSTEMD_WANTED_BY="default.target"
SYSTEMCTL_CMD=(systemctl --user)

expand_home_path() {
  local path="$1"
  case "$path" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${path#"~/"}" ;;
    *) printf '%s\n' "$path" ;;
  esac
}

set_scope() {
  local scope="${1:-user}"
  case "$scope" in
    user)
      SERVICE_SCOPE="user"
      SYSTEMD_WANTED_BY="default.target"
      SYSTEMCTL_CMD=(systemctl --user)
      CONFIG_DIR="${ICLOUD_CONFIG_DIR:-$HOME/.config/icloud-linux}"
      STATE_DIR="${ICLOUD_STATE_DIR:-$HOME/.local/state/icloud-linux}"
      CACHE_DIR="${ICLOUD_CACHE_DIR:-$HOME/.cache/icloud-linux}"
      SERVICE_DIR="${ICLOUD_SERVICE_DIR:-$HOME/.config/systemd/user}"
      MOUNT_DIR_DEFAULT="${ICLOUD_MOUNT_DEFAULT:-$HOME/iCloud}"
      ;;
    system)
      SERVICE_SCOPE="system"
      SYSTEMD_WANTED_BY="multi-user.target"
      SYSTEMCTL_CMD=(systemctl)
      CONFIG_DIR="${ICLOUD_CONFIG_DIR:-/root/.config/icloud-linux}"
      STATE_DIR="${ICLOUD_STATE_DIR:-/root/.local/state/icloud-linux}"
      CACHE_DIR="${ICLOUD_CACHE_DIR:-/root/.cache/icloud-linux}"
      SERVICE_DIR="${ICLOUD_SERVICE_DIR:-/etc/systemd/system}"
      MOUNT_DIR_DEFAULT="${ICLOUD_MOUNT_DEFAULT:-/root/iCloud}"
      ;;
    *)
      echo "Unknown service scope: $scope" >&2
      exit 1
      ;;
  esac
  CONFIG_FILE="$CONFIG_DIR/config.yaml"
  ENV_FILE="$CONFIG_DIR/icloud.env"
  SERVICE_FILE="$SERVICE_DIR/$SERVICE_NAME"
}

need_cmd() { command -v "$1" >/dev/null 2>&1 || { echo "Missing required command: $1"; exit 1; }; }

ensure_system_scope_allowed() {
  if [[ "$SERVICE_SCOPE" == "system" && "${EUID:-$(id -u)}" -ne 0 ]]; then
    echo "System-scope commands must run as root."
    exit 1
  fi
}

systemctl_run() {
  "${SYSTEMCTL_CMD[@]}" "$@"
}

read_config_scalar() {
  local key="$1"
  local default="${2:-}"
  local value=""
  if [[ -f "$CONFIG_FILE" ]]; then
    value="$(sed -n "s/^${key}:[[:space:]]*//p" "$CONFIG_FILE" | head -1)"
    value="${value%\"}"
    value="${value#\"}"
    value="${value%\'}"
    value="${value#\'}"
  fi
  if [[ -z "$value" ]]; then
    value="$default"
  fi
  expand_home_path "$value"
}

ensure_dirs() {
  mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$CACHE_DIR" "$SERVICE_DIR"
}

ensure_venv() {
  if [[ ! -x "$REPO_DIR/.venv/bin/python" ]]; then
    echo "Creating virtualenv..."
    python3 -m venv "$REPO_DIR/.venv"
  fi
  "$REPO_DIR/.venv/bin/pip" install -q -r "$REPO_DIR/requirements.txt"
}

create_config_if_missing() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    cp "$REPO_DIR/config.example.yaml" "$CONFIG_FILE"
    chmod 600 "$CONFIG_FILE"
    echo "Created $CONFIG_FILE"
  fi
}

write_service() {
  local mount_dir="$1"
  cat > "$SERVICE_FILE" <<EOF
[Unit]
Description=iCloud Linux FUSE filesystem ($SERVICE_SCOPE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/fusermount -uz $mount_dir
ExecStop=-/usr/bin/fusermount -uz $mount_dir
ExecStart=$REPO_DIR/.venv/bin/python $REPO_DIR/driver.py -f -c $CONFIG_FILE $mount_dir
Restart=on-failure
RestartSec=15
TimeoutStopSec=10
KillMode=control-group
ExecStopPost=-/usr/bin/fusermount -uz $mount_dir
WorkingDirectory=$REPO_DIR
Environment=ICLOUD_LOG_PATH=$STATE_DIR/icloud.log

[Install]
WantedBy=$SYSTEMD_WANTED_BY
EOF
}

write_env() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  mkdir -p "$mount_dir"
  cat > "$ENV_FILE" <<EOF
ICLOUD_CONFIG=$CONFIG_FILE
ICLOUD_MOUNT=$mount_dir
EOF
  chmod 600 "$ENV_FILE"
}

load_env_if_present() {
  if [[ -f "$ENV_FILE" ]]; then
    # shellcheck disable=SC1090
    source "$ENV_FILE"
  fi
}

cleanup_mountpoint() {
  load_env_if_present
  local mount_dir="${1:-${ICLOUD_MOUNT:-$MOUNT_DIR_DEFAULT}}"
  mkdir -p "$mount_dir"

  if mountpoint -q "$mount_dir"; then
    echo "Cleaning mounted FUSE endpoint at $mount_dir"
    fusermount -uz "$mount_dir" >/dev/null 2>&1 || fusermount -u "$mount_dir" >/dev/null 2>&1 || true
    sleep 1
  fi

  if [[ -d "$mount_dir" ]] && ! ls "$mount_dir" >/dev/null 2>&1; then
    echo "Cleaning stale FUSE transport endpoint at $mount_dir"
    fusermount -uz "$mount_dir" >/dev/null 2>&1 || true
    sleep 1
  fi
}

cmd_init() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  need_cmd systemctl
  ensure_system_scope_allowed
  ensure_dirs
  ensure_venv
  create_config_if_missing

  mkdir -p "$mount_dir"
  if [[ ! -w "$mount_dir" ]]; then
    local fallback="$HOME/iCloudDrive"
    mkdir -p "$fallback"
    if [[ -w "$fallback" ]]; then
      echo "Mount dir not writable: $mount_dir"
      echo "Using fallback mount dir: $fallback"
      mount_dir="$fallback"
    else
      echo "Mount dir is not writable: $mount_dir"
      echo "Fix with: sudo chown -R $USER:$USER '$mount_dir'"
      exit 1
    fi
  fi

  write_env "$mount_dir"
  write_service "$mount_dir"
  systemctl_run daemon-reload
  systemctl_run enable "$SERVICE_NAME" >/dev/null
  echo "Initialized."
  echo "- Config: $CONFIG_FILE"
  echo "- Env:    $ENV_FILE"
  echo "- Mount:  $mount_dir"
  echo "Next: ./icloudctl auth"
}

cmd_configure() {
  ensure_dirs
  create_config_if_missing
  local email="${1:-}"
  if [[ -z "$email" ]]; then
    read -r -p "Apple ID email: " email
  fi
  read -r -s -p "Apple ID password (input hidden): " password
  echo
  cat > "$CONFIG_FILE" <<EOF
username: "$email"
password: "$password"
cache_dir: "$CACHE_DIR"
warmup_mode: "background"
conflict_mode: "copy"
upload_interval_seconds: 30
remote_refresh_interval_seconds: 300
warmup_workers: 1
cookie_dir: "$CONFIG_DIR/cookies"
permissions:
  file_mode: "0644"
  dir_mode: "0755"
  # uid: 1000
  # gid: 1000
fuse_options:
  allow_other: false
  ro: false
  nonempty: true
EOF
  chmod 600 "$CONFIG_FILE"
  echo "Wrote $CONFIG_FILE"
}

cmd_auth() {
  ensure_venv
  create_config_if_missing
  "$REPO_DIR/.venv/bin/python" "$REPO_DIR/auth.py" "$CONFIG_FILE"
}

cmd_auth_status() {
  local cookie_dir
  local username
  local newest_mtime
  local now
  local age_days
  local days_left
  local status

  username="$(read_config_scalar "username" "")"
  cookie_dir="$(read_config_scalar "cookie_dir" "$CONFIG_DIR/cookies")"

  echo "== icloud-linux auth status =="
  echo "Config: $CONFIG_FILE"
  if [[ -n "$username" ]]; then
    echo "Apple ID: $username"
  fi
  echo "Cookie dir: $cookie_dir"

  if [[ ! -d "$cookie_dir" ]] || [[ -z "$(ls -A "$cookie_dir" 2>/dev/null)" ]]; then
    echo "Status: not authenticated"
    echo "Session age: unknown"
    echo "Days left: unknown"
    echo "Next: ./icloudctl auth"
    return 1
  fi

  newest_mtime="$(find "$cookie_dir" -type f -printf '%T@\n' 2>/dev/null | sort -n | tail -1 | cut -d. -f1)"
  if [[ -z "$newest_mtime" ]]; then
    echo "Status: not authenticated"
    echo "Session age: unknown"
    echo "Days left: unknown"
    echo "Next: ./icloudctl auth"
    return 1
  fi

  now="$(date +%s)"
  age_days=$(( (now - newest_mtime) / 86400 ))
  days_left=$(( 60 - age_days ))

  if [[ "$days_left" -le 0 ]]; then
    status="expired"
  elif [[ "$days_left" -le 10 ]]; then
    status="reauthenticate soon"
  else
    status="authenticated"
  fi

  echo "Status: $status"
  echo "Session age: ${age_days} day(s)"
  echo "Days left: ~${days_left} day(s)"
}

cmd_start() { ensure_system_scope_allowed; cleanup_mountpoint "${1:-}"; systemctl_run start "$SERVICE_NAME"; systemctl_run --no-pager status "$SERVICE_NAME"; }
cmd_stop() { ensure_system_scope_allowed; systemctl_run stop "$SERVICE_NAME" >/dev/null 2>&1 || true; cleanup_mountpoint "${1:-}"; systemctl_run --no-pager status "$SERVICE_NAME" || true; }
cmd_restart() { ensure_system_scope_allowed; systemctl_run stop "$SERVICE_NAME" >/dev/null 2>&1 || true; cleanup_mountpoint "${1:-}"; systemctl_run start "$SERVICE_NAME"; systemctl_run --no-pager status "$SERVICE_NAME"; }
cmd_status() { ensure_system_scope_allowed; systemctl_run --no-pager status "$SERVICE_NAME"; }
cmd_logs() {
  if [[ "$SERVICE_SCOPE" == "system" ]]; then
    journalctl -u "$SERVICE_NAME" -f
  else
    journalctl --user -u "$SERVICE_NAME" -f
  fi
}
cmd_clear_cache() {
  local was_active=0
  ensure_system_scope_allowed
  systemctl_run is-active --quiet "$SERVICE_NAME" && was_active=1 || true
  systemctl_run stop "$SERVICE_NAME" >/dev/null 2>&1 || true
  rm -rf "$CACHE_DIR"
  mkdir -p "$CACHE_DIR"
  echo "Cleared persistent cache under $CACHE_DIR"
  if [[ "$was_active" -eq 1 ]]; then
    echo "Restarting service to rebuild cache..."
    systemctl_run start "$SERVICE_NAME"
    systemctl_run --no-pager status "$SERVICE_NAME"
  else
    echo "Service is stopped. Start it with './icloudctl start' to rebuild cache."
  fi
}

cmd_uninstall() {
  local purge="${1:-}"
  ensure_system_scope_allowed
  systemctl_run stop "$SERVICE_NAME" >/dev/null 2>&1 || true
  systemctl_run disable "$SERVICE_NAME" >/dev/null 2>&1 || true
  rm -f "$SERVICE_FILE"
  systemctl_run daemon-reload
  systemctl_run reset-failed >/dev/null 2>&1 || true

  if [[ "$purge" == "--purge" ]]; then
    rm -f "$CONFIG_FILE" "$ENV_FILE"
    rm -rf "$CONFIG_DIR/cookies" "$CACHE_DIR" "$STATE_DIR"
    echo "Uninstalled and purged local config/cache/session data."
  else
    echo "Uninstalled service. Config/cookies/cache kept."
    echo "Use './icloudctl uninstall --purge' to remove local data too."
  fi
}

cmd_doctor() {
  echo "== icloud-linux doctor =="
  for c in python3 systemctl fusermount; do
    if command -v "$c" >/dev/null 2>&1; then echo "OK: $c"; else echo "MISSING: $c"; fi
  done
  [[ -x "$REPO_DIR/.venv/bin/python" ]] && echo "OK: virtualenv" || echo "MISSING: virtualenv"
  [[ -f "$CONFIG_FILE" ]] && echo "OK: config" || echo "MISSING: $CONFIG_FILE"
  if [[ -f "$ENV_FILE" ]]; then
    echo "OK: env"
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    if [[ -n "${ICLOUD_MOUNT:-}" ]]; then
      [[ -w "$ICLOUD_MOUNT" ]] && echo "OK: mount writable ($ICLOUD_MOUNT)" || echo "WARN: mount not writable ($ICLOUD_MOUNT)"
    fi
  else
    echo "MISSING: $ENV_FILE"
  fi
  systemctl_run --no-pager status "$SERVICE_NAME" >/dev/null 2>&1 && echo "OK: service exists" || echo "WARN: service not initialized"
}

cmd_quickstart() {
  local mount_dir="${1:-$MOUNT_DIR_DEFAULT}"
  cmd_init "$mount_dir"
  echo
  echo "Now configure credentials:"
  cmd_configure
  echo
  echo "Authenticate (2FA):"
  cmd_auth
  echo
  echo "Starting service..."
  cmd_start
}

cmd_init_system() { set_scope system; cmd_init "$@"; }
cmd_start_system() { set_scope system; cmd_start "$@"; }
cmd_stop_system() { set_scope system; cmd_stop "$@"; }
cmd_restart_system() { set_scope system; cmd_restart "$@"; }
cmd_status_system() { set_scope system; cmd_status; }
cmd_logs_system() { set_scope system; cmd_logs; }
cmd_doctor_system() { set_scope system; cmd_doctor; }
cmd_clear_cache_system() { set_scope system; cmd_clear_cache; }
cmd_uninstall_system() { set_scope system; cmd_uninstall "$@"; }

usage() {
  cat <<EOF
Usage: ./icloudctl <command> [args]

Commands:
  quickstart [mount_dir]   One-command guided setup
  init [mount_dir]         Initialize venv/config/service files
  init-system [mount_dir]  Initialize venv/config/system service files
  configure [email]        Write config.yaml with credentials
  auth                     Run interactive 2FA bootstrap
  auth-status              Show session age and approximate days left
  clear-cache              Remove local mirror/state and rebuild on next start
  start|stop|restart       Service control
  status                   Show service status
  logs                     Tail service logs
  doctor                   Check local setup health
  start-system|stop-system|restart-system
                           System service control for container/root installs
  status-system            Show system service status
  logs-system              Tail system service logs
  doctor-system            Check system-scope setup health
  clear-cache-system       Clear cache for a system-scope install
  uninstall-system [--purge]
                           Remove system service (optionally remove local data)
  uninstall [--purge]      Remove service (optionally remove local data)
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  set_scope user
  case "$cmd" in
    quickstart) cmd_quickstart "$@" ;;
    init) cmd_init "$@" ;;
    init-system) cmd_init_system "$@" ;;
    configure) cmd_configure "$@" ;;
    auth) cmd_auth ;;
    auth-status) cmd_auth_status ;;
    clear-cache) cmd_clear_cache ;;
    clear-cache-system) cmd_clear_cache_system ;;
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    status) cmd_status ;;
    logs) cmd_logs ;;
    doctor) cmd_doctor ;;
    start-system) cmd_start_system "$@" ;;
    stop-system) cmd_stop_system "$@" ;;
    restart-system) cmd_restart_system "$@" ;;
    status-system) cmd_status_system ;;
    logs-system) cmd_logs_system ;;
    doctor-system) cmd_doctor_system ;;
    uninstall) cmd_uninstall "$@" ;;
    uninstall-system) cmd_uninstall_system "$@" ;;
    ""|-h|--help|help) usage ;;
    *) echo "Unknown command: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
